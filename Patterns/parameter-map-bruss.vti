<?xml version="1.0"?>
<VTKFile type="ImageData" version="0.1" byte_order="LittleEndian" header_type="UInt32" compressor="vtkZLibDataCompressor">
  <RD format_version="6">
    <description>
      A map of the parameters of the Gray-Scott system. Here &apos;k&apos; increases from left to
      right and &apos;F&apos; increases from bottom to top. For more detail, see:
      &lt;a href=&quot;http://mrob.com/pub/comp/xmorphia/index.html&quot;&gt;http://mrob.com/pub/comp/xmorphia/index.html&lt;/a&gt;
      
      P. Gray, S.K. Scott (1984) &lt;a href=&quot;https://www.sciencedirect.com/science/article/pii/0009250984870177&quot;&gt;Autocatalytic reactions in the isothermal, continuous stirred tank reactor: Oscillations and instabilities in the system A + 2B → 3B; B → C&lt;/a&gt; Chemical Engineering Science, Volume 39, Issue 6.
      
      The parameters k1, k2, F1 and F2 define the current range of the map. Change them to explore.
      
    </description>
    <rule name="Gray-Scott" type="formula" wrap="0" neighborhood_type="vertex">
      <param name="timestep">
        0.000500
      </param>
      <param name="diff">
        2.000000
      </param>
      <param name="k1">
        0.500000
      </param>
      <param name="k2">
        10.000000
      </param>
      <param name="F1">
        0.500000
      </param>
      <param name="F2">
        3.000000
      </param>
      <formula number_of_chemicals="2" block_size_x="4" block_size_y="1" block_size_z="1" accuracy="medium">
        float4 alpha = k1 + (k2-k1)*x_pos;
        float4 F = F1 + (F2-F1)*y_pos;
        float4 beta = F * alpha;
        delta_a = diff * laplacian_a + a*a*b + alpha - (beta + 1.0f) * a;
        delta_b = 8 * diff * laplacian_b - a*a*b + beta*a;
      </formula>
    </rule>
    <initial_pattern_generator apply_when_loading="false" zero_first="true">
      <overlay chemical="a">
        <overwrite/>
        <linear_gradient val1="0.1" val2="10">
          <point3D x="0" y="0" z="0"/>
          <point3D x="1" y="0" z="1"/>
        </linear_gradient>
        <everywhere/>
      </overlay>
      <overlay chemical="a">
        <add/>
        <white_noise low="-0.5" high="0.5"/>
        <everywhere/>
      </overlay>
      <overlay chemical="b">
        <overwrite/>
        <linear_gradient val1="0.5" val2="3">
          <point3D x="0" y="0" z="0"/>
          <point3D x="0" y="1" z="1"/>
        </linear_gradient>
        <everywhere/>
      </overlay>
      <overlay chemical="b">
        <add/>
        <white_noise low="-0.5" high="0.5"/>
        <everywhere/>
      </overlay>
    </initial_pattern_generator>
    <render_settings>
      <surface_color r="1" g="1" b="1"/>
      <colormap value="spectral"/>
      <color_low r="0" g="0" b="1"/>
      <color_high r="1" g="0" b="0"/>
      <show_color_scale value="true"/>
      <show_multiple_chemicals value="true"/>
      <active_chemical value="a"/>
      <low value="0"/>
      <high value="15"/>
      <vertical_scale_1D value="30"/>
      <vertical_scale_2D value="15"/>
      <contour_level value="0.25"/>
      <cap_contour value="true"/>
      <invert_contour_cap value="false"/>
      <use_wireframe value="false"/>
      <show_cell_edges value="false"/>
      <show_bounding_box value="true"/>
      <show_chemical_label value="true"/>
      <slice_3D value="true"/>
      <slice_3D_axis value="z"/>
      <slice_3D_position value="0.5"/>
      <show_displacement_mapped_surface value="false"/>
      <color_displacement_mapped_surface value="false"/>
      <use_image_interpolation value="true"/>
      <timesteps_per_render value="100"/>
      <show_phase_plot value="false"/>
      <phase_plot_x_axis value="a"/>
      <phase_plot_y_axis value="b"/>
      <phase_plot_z_axis value="c"/>
      <plot_ab_orthogonally value="false"/>
    </render_settings>
  </RD>
  <ImageData WholeExtent="0 255 0 255 0 0" Origin="0 0 0" Spacing="1 1 1">
  <Piece Extent="0 255 0 255 0 0">
    <PointData>
      <DataArray type="Float32" Name="a" format="binary" RangeMin="0.27662378549575806" RangeMax="17.260807037353516">
        
      </DataArray>
      <DataArray type="Float32" Name="b" format="binary" RangeMin="0.49736547470092773" RangeMax="4.237346649169922">
        
      </DataArray>
    </PointData>
    <CellData>
    </CellData>
  </Piece>
  </ImageData>
</VTKFile>
