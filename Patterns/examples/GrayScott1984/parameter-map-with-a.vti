<?xml version="1.0"?>
<VTKFile type="ImageData" version="0.1" byte_order="LittleEndian" header_type="UInt32" compressor="vtkZLibDataCompressor">
<RD format_version="6">
    <description>
        A map of the parameters of the Gray-Scott system. Here 'k' increases from left to
        right and 'F' increases from bottom to top. For more detail, see:
        &lt;a href=&quot;http://mrob.com/pub/comp/xmorphia/index.html&quot;&gt;http://mrob.com/pub/comp/xmorphia/index.html&lt;/a&gt;

        P. Gray, S.K. Scott (1984) &lt;a href=&quot;https://www.sciencedirect.com/science/article/pii/0009250984870177&quot;&gt;Autocatalytic reactions in the isothermal, continuous stirred tank reactor: Oscillations and instabilities in the system A + 2B → 3B; B → C&lt;/a&gt; Chemical Engineering Science, Volume 39, Issue 6.

        The parameters k1, k2, F1 and F2 define the current range of the map. Change them to explore.
    </description>

    <rule type="formula" name="Gray-Scott" wrap="0">

      <param name="timestep"> 0.2   </param>
      <param name="diff">     0.07  </param>
      <param name="k1">       0.03  </param>
      <param name="k2">       0.07  </param>
      <param name="F1">       0.0   </param>
      <param name="F2">       0.1   </param>
      <formula number_of_chemicals="2">
        float4 k = k1 + (k2-k1)*x_pos;
        float4 F = F1 + (F2-F1)*y_pos;
        delta_a = 2.0f * diff * laplacian_a - a*b*b + F*(1.0f-a);
        delta_b = diff * laplacian_b + a*b*b - (F+k)*b;
      </formula>

    </rule>

    <initial_pattern_generator apply_when_loading="false">
      <overlay chemical="a">
        <overwrite />
        <constant value="1" />
        <everywhere />
      </overlay>
      <overlay chemical="b">
        <overwrite />
        <white_noise low="0" high="1" />
        <rectangle>
          <point3D x="0.2" y="0.2" z="0.6" />
          <point3D x="0.4" y="0.5" z="0.8" />
        </rectangle>
      </overlay>
    </initial_pattern_generator>

    <render_settings>
        <show_displacement_mapped_surface value="false" />
        <show_multiple_chemicals value="false" />
        <active_chemical value="b" />
    </render_settings>

  </RD>
  <ImageData WholeExtent="0 255 0 255 0 0" Origin="0 0 0" Spacing="1 1 1" Direction="1 0 0 0 1 0 0 0 1">
  <Piece Extent="0 255 0 255 0 0">
    <PointData>
      <DataArray type="Float64" Name="a" format="binary" RangeMin="0.000020564670993761247" RangeMax="0.999998149218383">
        
      </DataArray>
      <DataArray type="Float32" Name="b" format="binary" RangeMin="0" RangeMax="0">
        
      </DataArray>
    </PointData>
    <CellData>
    </CellData>
  </Piece>
  </ImageData>
</VTKFile>
